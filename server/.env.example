# Copy this file to .env and fill in real values before running the server.
# Never commit the actual .env file to git — it's already in .gitignore.

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting providers set this automatically
# (via process.env.PORT) — only change this for local development if 4000
# is already in use on your machine.
PORT=4000

# The URL your frontend will be served from, for CORS purposes. For local
# development with `npm run dev` on the frontend, this is correct as-is.
# When you deploy, set this to your actual frontend URL, e.g.
# https://divyakeerthi.vercel.app
FRONTEND_URL=http://localhost:5173

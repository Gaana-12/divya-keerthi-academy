# Copy this file to .env before running the app, and adjust if needed.

# Where the backend server is running. The default below matches the
# backend's default local port (see server/.env.example). If you deploy
# the backend elsewhere, update this to its real URL, e.g.
# https://api.divyakeerthi.com/api
VITE_API_URL=http://localhost:4000/api
